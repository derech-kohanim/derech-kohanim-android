<?xml version="1.0" encoding="utf-8"?>
<!--
    Bundles the NetFree CA certificates so the app works on a device where the NetFree roots
    were never installed system-wide. Certs and layout are taken from the kdroidFilter
    Netfree-Tools android-certificates module.

    ADDITIVE ON PURPOSE: the trust anchors list the NetFree roots AND `system`, so the app
    keeps trusting the normal public CAs. On a non-NetFree network everything works exactly as
    before; on a NetFree network the intercepting roots are also trusted. This never replaces
    the system store.

    Scope: network-security-config applies from API 24 (our minSdk is 30, so fine) and only to
    the Android TLS stack (HttpsURLConnection, OkHttp, WebView). Components with their own
    trust store (Cronet, native TLS) are not covered - see the README note about Google Maps.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <!-- Current unified NetFree roots (X2), https://netfree.link/cacert/united/x2/ -->
            <certificates src="@raw/netfree_root_ca_x2_rsa" />
            <certificates src="@raw/netfree_root_ca_x2_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_x2_prime256v1" />
            <certificates src="@raw/netfree_root_ca_x2_secp384r1" />
            <certificates src="@raw/netfree_root_ca_x2_ed25519" />

            <!-- Legacy unified NetFree roots, still used by accounts not migrated to X2 -->
            <certificates src="@raw/netfree_root_ca_rsa" />
            <certificates src="@raw/netfree_root_ca_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_prime256v1" />
            <certificates src="@raw/netfree_root_ca_secp384r1" />
            <certificates src="@raw/netfree_root_ca_ed25519" />

            <!-- Per ISP signing certificates from the previous generation -->
            <certificates src="@raw/netfree_bezeq" />
            <certificates src="@raw/netfree_018" />
            <certificates src="@raw/netfree_099" />
            <certificates src="@raw/netfree_amitnet" />
            <certificates src="@raw/netfree_hadran_vpn" />
            <certificates src="@raw/netfree_hot" />
            <certificates src="@raw/netfree_ib_itc" />
            <certificates src="@raw/netfree_ib_partner" />
            <certificates src="@raw/netfree_ib_spotnet" />
            <certificates src="@raw/netfree_itc" />
            <certificates src="@raw/netfree_simkasher_cellcom" />
            <certificates src="@raw/netfree_simkasher_itc" />
            <certificates src="@raw/netfree_simkasher_patner" />
            <certificates src="@raw/netfree_simkasher_pelephone" />
            <certificates src="@raw/netfree_simkasher_triplec" />
            <certificates src="@raw/netfree_yossitikshoret" />

            <!-- Keep trusting the public CA store, so normal internet and Google APIs work. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Local development only. Declaring a base-config makes the default cleartext policy
        apply (blocked on API 28+), which would break the dev server over HTTP. Permit
        cleartext for loopback hosts only; production traffic is HTTPS. Trust anchors are
        inherited from base-config.

        The debug API base is http://127.0.0.1:3001/api - it reaches the host dev server from
        a real device over USB (`adb reverse tcp:3001 tcp:3001`) and from the emulator.
        10.0.2.2 is the emulator-only host alias, kept here for that path.

        If instead you point API_BASE_URL at the host's LAN IP (only works when the device and
        host share a subnet), add that IP here so cleartext to it is permitted, for example:
            <domain includeSubdomains="true">192.168.10.145</domain>
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <!--
        Map tiles for the MapLibre / OpenFreeMap renderer. Tiles come from a THIRD-PARTY host
        that NetFree MITMs with its own CA, so the tile domain must trust the NetFree roots the
        same way the API host already does. A <domain-config>'s trust-anchors REPLACE (do not
        extend) the inherited base-config set, so the full list is repeated here rather than
        added - this keeps the extra `user` anchor SCOPED to the tile domain and never weakens
        the API host (which stays on base-config: bundled NetFree roots + system only).

        Anchors, in order of preference:
          - the bundled NetFree roots: zero user action, works out of the box on NetFree;
          - `system`: normal public CAs on a non-NetFree network;
          - `user`: covers a NetFree deployment whose root is not in the bundle but the user
            installed it themselves. Embedding that CA as an @raw resource here would restore
            zero-user-action support for it too.
        No certificate pinning is applied, so a NetFree-issued tile cert is accepted.

        A future self-hosted tile/style domain (see BuildConfig.MAPLIBRE_STYLE_URL) should be
        added as another <domain> below.
    -->
    <domain-config>
        <domain includeSubdomains="true">tiles.openfreemap.org</domain>
        <trust-anchors>
            <!-- Current unified NetFree roots (X2) -->
            <certificates src="@raw/netfree_root_ca_x2_rsa" />
            <certificates src="@raw/netfree_root_ca_x2_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_x2_prime256v1" />
            <certificates src="@raw/netfree_root_ca_x2_secp384r1" />
            <certificates src="@raw/netfree_root_ca_x2_ed25519" />

            <!-- Legacy unified NetFree roots -->
            <certificates src="@raw/netfree_root_ca_rsa" />
            <certificates src="@raw/netfree_root_ca_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_prime256v1" />
            <certificates src="@raw/netfree_root_ca_secp384r1" />
            <certificates src="@raw/netfree_root_ca_ed25519" />

            <!-- Per ISP signing certificates from the previous generation -->
            <certificates src="@raw/netfree_bezeq" />
            <certificates src="@raw/netfree_018" />
            <certificates src="@raw/netfree_099" />
            <certificates src="@raw/netfree_amitnet" />
            <certificates src="@raw/netfree_hadran_vpn" />
            <certificates src="@raw/netfree_hot" />
            <certificates src="@raw/netfree_ib_itc" />
            <certificates src="@raw/netfree_ib_partner" />
            <certificates src="@raw/netfree_ib_spotnet" />
            <certificates src="@raw/netfree_itc" />
            <certificates src="@raw/netfree_simkasher_cellcom" />
            <certificates src="@raw/netfree_simkasher_itc" />
            <certificates src="@raw/netfree_simkasher_patner" />
            <certificates src="@raw/netfree_simkasher_pelephone" />
            <certificates src="@raw/netfree_simkasher_triplec" />
            <certificates src="@raw/netfree_yossitikshoret" />

            <!-- Public CAs on a normal network. -->
            <certificates src="system" />
            <!-- A NetFree root the user installed themselves but that is not bundled above. -->
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
