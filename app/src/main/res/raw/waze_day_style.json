{
  "version": 8,
  "name": "Derech Kohanim - Waze Day",
  "metadata": {
    "dk:description": "Waze Navigation - Day palette for the OpenMapTiles schema served by OpenFreeMap. Recoloured OSM/Positron-style layer set. Overlays (zones, route, markers) are added on top at runtime by DkMapLibre.kt."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f2f0e8" }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood", "commercial", "industrial", "retail", "railway", "quarter"],
      "paint": { "fill-color": "#edeae0", "fill-opacity": 0.7 }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": { "fill-color": "#c4dfa6", "fill-opacity": 0.9 }
    },
    {
      "id": "landcover-scrub",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "scrub", "shrub", "heath"],
      "paint": { "fill-color": "#d8e5c2", "fill-opacity": 0.9 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "meadow"],
      "paint": { "fill-color": "#b8e0a0", "fill-opacity": 0.75 }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "sand", "beach"],
      "paint": { "fill-color": "#eee2c6" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "garden", "recreation_ground", "grass", "meadow", "cemetery", "pitch", "playground"],
      "paint": { "fill-color": "#b8e0a0", "fill-opacity": 0.7 }
    },
    {
      "id": "park-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#c1e3ab", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all", ["==", "$type", "Polygon"], ["!=", "intermittent", 1]],
      "paint": { "fill-color": "#9ccdeb" }
    },
    {
      "id": "water-intermittent",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all", ["==", "$type", "Polygon"], ["==", "intermittent", 1]],
      "paint": { "fill-color": "#9ccdeb", "fill-opacity": 0.6 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#9ccdeb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 1.4, 18, 3]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e4e0d4",
        "fill-outline-color": "#d6d1c2",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 15, 1]
      }
    },

    {
      "id": "road-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "rail", "transit"]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#d3ccba",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 14, 1.2, 18, 3]
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service"], ["!=", "subclass", "parking_aisle"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#dfdacb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.2, 14, 3.5, 16, 8, 20, 26]
      }
    },
    {
      "id": "road-parking-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "subclass", "parking_aisle"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#f4f1e7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1.5, 16, 4, 20, 16]
      }
    },
    {
      "id": "road-link-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "subclass", "motorway_link", "trunk_link", "primary_link", "secondary_link", "tertiary_link"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#ecc26a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.5, 14, 4, 16, 8, 20, 22]
      }
    },
    {
      "id": "road-arterial-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "primary", "secondary", "tertiary"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#d6d0be",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 12, 3, 14, 6, 16, 12, 20, 34]
      }
    },
    {
      "id": "road-highway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "motorway", "trunk"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#e3a83a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.2, 8, 2.5, 12, 6, 14, 10, 16, 16, 20, 40]
      }
    },

    {
      "id": "road-parking-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "subclass", "parking_aisle"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#fcfaf4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.8, 16, 2.5, 20, 12]
      }
    },
    {
      "id": "road-minor-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "minor", "service"], ["!=", "subclass", "parking_aisle"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 14, 2, 16, 6, 20, 22]
      }
    },
    {
      "id": "road-link-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "subclass", "motorway_link", "trunk_link", "primary_link", "secondary_link", "tertiary_link"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#fddf9a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 14, 2.5, 16, 5.5, 20, 18]
      }
    },
    {
      "id": "road-arterial-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "primary", "secondary", "tertiary"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 2, 14, 4.5, 16, 9, 20, 28]
      }
    },
    {
      "id": "road-highway-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "motorway", "trunk"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#fbce60",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 8, 1.6, 12, 4.5, 14, 7.5, 16, 12, 20, 32]
      }
    },

    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#c9c3b2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 8, 1.6, 12, 2.5],
        "line-dasharray": [3, 1]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 4,
      "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#d3ccba",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 8, 1, 12, 1.8],
        "line-dasharray": [2, 2]
      }
    },

    {
      "id": "waterway-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 12,
      "filter": ["==", "$type", "LineString"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "#34718f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["==", "$type", "Point"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 14],
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#34718f",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },

    {
      "id": "road-label-local",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["in", "class", "minor", "service"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 10, 18, 13],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4a4844",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-label-arterial",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["in", "class", "primary", "secondary", "tertiary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 18, 14],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#403e3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road-label-highway",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "filter": ["in", "class", "motorway", "trunk"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 18, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4e3b10",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": ["all", ["==", "$type", "Point"], ["<=", "rank", 8]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-width": 8,
        "text-anchor": "top",
        "text-offset": [0, 0.6]
      },
      "paint": {
        "text-color": [
          "match", ["get", "class"],
          ["park", "wood", "garden"], "#4f8235",
          ["hospital", "pharmacy"], "#b4534f",
          "#78736a"
        ],
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },

    {
      "id": "place-park-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 12,
      "filter": ["==", "$type", "Point"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4f8235",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["in", "class", "suburb", "quarter", "neighbourhood"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 15, 15],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#8a8479",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": ["in", "class", "village", "hamlet", "isolated_dwelling"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 11, 14, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#78736a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 12, 14, 17],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3b3936",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 9,
      "filter": ["==", "class", "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 8, 15],
        "text-max-width": 8,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#57534a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 13, 12, 20],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3b3936",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "maxzoom": 10,
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:he"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 12, 8, 20],
        "text-max-width": 8,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#3b3936",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
